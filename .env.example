# Plantilla de variables de entorno de la app web DIAN.
# Cópiala a tu entorno (Render Settings → Environment) o a un .env local.

# Obligatoria en producción: firma las sesiones.
# Genera una con:  openssl rand -hex 32
APP_SECRET_KEY=

# Usuario/contraseña del primer administrador (quien aprueba altas).
APP_ADMIN_USER=
APP_ADMIN_PASS=

# Opcional: 'dev' permite arrancar sin APP_SECRET_KEY (solo desarrollo local).
APP_ENV=

# Opcional: duración de sesión en horas (default 12).
APP_SESSION_HOURS=12

# Opcional: persistencia y trabajos (default: data/ y data/jobs en el directorio de la app).
APP_DATA_DIR=data
APP_JOBS_DIR=data/jobs